      style.fill: "#ffeb3b"
    }

    table-z: {
      label: Table Z
      shape: cylinder
      style.fill: "#ffeb3b"
    }
  }

  transform: {
    label: Transform Query\nSelect FROM XYZ tables,\nINSERT into BrazeIngestion.Users\nAS XYZ value
    style.fill: "#ffe082"
