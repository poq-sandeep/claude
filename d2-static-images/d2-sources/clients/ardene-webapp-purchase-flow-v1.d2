  style.stroke: "#f57c00"
  style.stroke-width: 3
  style.font-color: "#f57c00"
  style.bold: true
}

# Flow 2a-2d: CrowdTwist to Braze
crowdtwist.braze-forward -> braze.event-data-purchase: {
  label: "2a\nEvent Data - Purchase Activity\nusers/track"
  style.stroke: "#7b1fa2"
  style.stroke-width: 2
  style.font-size: 10
}

crowdtwist.braze-forward -> braze.attribute-data: {
  label: "2b\nAttribute Data - Point Balance\nusers/track"
  style.stroke: "#7b1fa2"
  style.stroke-width: 2
  style.font-size: 10
}

crowdtwist.braze-forward -> braze.event-data-redemption: {
  label: "2c\nEvent Data - Redemption Data\nusers/track"
  style.stroke: "#7b1fa2"
  style.stroke-width: 2
  style.font-size: 10
}

crowdtwist.loyalty-processing -> crowdtwist.braze-forward: {
  label: "Processing"
  style.stroke: "#f57c00"
}

# Flow 3: Braze Campaigns
braze.event-data-purchase -> braze.triggered-campaign: {
