  style.stroke: "#9c27b0"
}

braze.audience-building -> braze.channel-orchestration: "Campaigns/Canvas" {
  style.stroke: "#9c27b0"
}

braze.channel-orchestration -> braze.notifications.transactional: {
  style.stroke: "#9c27b0"
}

braze.channel-orchestration -> braze.notifications.marketing: {
  style.stroke: "#9c27b0"
}

braze.notifications.transactional -> channels.email: "post /transactional/v1/campaigns" {
  style.stroke: "#00acc1"
  style.stroke-width: 2
}

braze.notifications.transactional -> channels.sms: {
  style.stroke: "#00acc1"
  style.stroke-width: 2
}

braze.notifications.marketing -> channels.email: {
  style.stroke: "#00acc1"
  style.stroke-width: 2
}

braze.notifications.marketing -> channels.sms: {
  style.stroke: "#00acc1"
  style.stroke-width: 2
}

braze.notifications.marketing -> channels.web: {
  style.stroke: "#00acc1"
  style.stroke-width: 2
}

braze.notifications.marketing -> channels.app: {
  style.stroke: "#00acc1"
  style.stroke-width: 2
}

braze.braze-currents -> gcp.gcp-bucket: "6\nServer-to-Server (S2S)" {
  style.stroke: "#f9a825"
  style.stroke-width: 2
}

gcp.gcp-bucket -> gcp.bigquery.currents-tables: "7\nPurchase Events\nProfile Updates" {
  style.stroke: "#f9a825"
}

azure.fabric.data-warehouse -> braze.user-event-data: "5\nCDI Sync\n*15 min listener" {
  style.stroke: "#1976d2"
  style.stroke-width: 2
  style.stroke-dash: 3
}

touchpoints.web-app.web -> braze.user-event-data: "3\nBraze SDK" {
  style.stroke: "#7b1fa2"
  style.stroke-dash: 3
}

touchpoints.web-app.app -> braze.user-event-data: "3\nBraze SDK" {
  style.stroke: "#7b1fa2"
  style.stroke-dash: 3
}

# Legend
legend: {
  shape: text
  near: bottom-right
  label: |md
    ## Data Flow Legend

    - **1a-1b**: Physical Store → Azure (XML Data)
    - **2a-2b**: Azure Processing → Data Warehouse
    - **3**: In-Store Purchase → CrowdTwist
    - **4**: CrowdTwist → Braze (Loyalty Updates)
    - **5**: Azure → Braze (CDI Sync - 15 min)
    - **6**: Braze Currents → GCP (S2S)
    - **7**: GCP Bucket → BigQuery
    - **8**: Shopify Catalog Sync
  |
  style: {
    font-size: 11
    fill: "#f5f5f5"
    stroke: "#666"
    stroke-width: 1
  }
}

notes: {
  shape: text
  near: bottom-left
  label: |md
    ## Key Integration Points

    - **Shopify**: eCommerce platform with SDK integration
    - **CrowdTwist**: Loyalty program management
    - **Braze**: CDP/CRM for orchestration and campaigns
    - **Azure**: Data processing and warehousing
    - **GCP**: Analytics data storage (BigQuery)

    ### Communication Protocols
    - REST API (Server-to-Server)
    - SDK (Web/Mobile Apps)
    - Webhooks (Event-driven)
  |
  style: {
    font-size: 11
    fill: "#e8f5e9"
    stroke: "#388e3c"
    stroke-width: 1
  }
}
