# Flow 1: Web/Mobile Update Event
touchpoints.web-mobile -> crowdtwist.profile-update: {
  label: "1\nWeb/Mobile Update Event\n*completes or updates profile"
  style.stroke: "#f57c00"
  style.stroke-width: 3
  style.font-color: "#f57c00"
  style.bold: true
}

# Alternative paths from CrowdTwist
crowdtwist.braze-forward -> braze.rest-api: {
  label: "2a\nREST API (S2S)\nusers/track"
  style.stroke: "#7b1fa2"
  style.stroke-width: 2
  style.font-color: "#7b1fa2"
}

crowdtwist.braze-forward -> braze.attribute-update: {
  label: "2b\nAttribute Update - Profile\nUpdate/Change"
  style.stroke: "#7b1fa2"
  style.stroke-width: 2
  style.font-color: "#7b1fa2"
}

# Flow 2: Braze SDK Path (Alternative)
touchpoints.web-mobile -> shopify.shopify-system: {
  label: "1a\nSDK"
  style.stroke: "#388e3c"
  style.stroke-width: 2
}

shopify.shopify-system -> braze.sdk: {
  label: "1b\nBraze SDK"
  style.stroke: "#7b1fa2"
  style.stroke-width: 2
}

# Flow 3: CrowdTwist to Braze Attribute Data
crowdtwist.braze-forward -> braze.attribute-data: {
  label: "3a\nAttribute Data - Point Balance\nusers/track"
  style.stroke: "#7b1fa2"
  style.stroke-width: 2
  style.font-color: "#7b1fa2"
}

braze.attribute-update -> braze.triggered-campaign: {
  label: "3b\nTrigger Campaign/Canvas"
  style.stroke: "#9c27b0"
  style.stroke-width: 2
}

braze.triggered-campaign -> channels.email: {
  label: "3c"
  style.stroke: "#00acc1"
  style.stroke-width: 2
}

braze.triggered-campaign -> channels.sms: {
  label: "3c"
  style.stroke: "#00acc1"
  style.stroke-width: 2
}

# Notes
notes: {
  shape: text
  near: bottom-left
  label: |md
    ## Data Flow Steps

    ### Path 1: Direct Profile Update
    - **1**: Web/Mobile app sends update event to CrowdTwist
    - **2a**: REST API (S2S) users/track to Braze
    - **2b**: Attribute update (Profile Update/Change)
    - **3b**: Triggered Campaign/Canvas
    - **3c**: Send to Email/SMS channels

    ### Path 2: SDK Integration (Alternative)
    - **1a**: SDK integration from Web/Mobile to Shopify
    - **1b**: Braze SDK processes data
    - **3a**: Attribute data (Point Balance) updated
    - **3b-3c**: Campaign trigger and channel delivery

    ### Key Notes
    - Profile updates can complete or modify existing profiles
    - Point balance updates flow through CrowdTwist
    - Campaigns/Canvas triggered based on profile changes
  |
  style: {
    font-size: 11
    fill: "#f5f5f5"
    stroke: "#666"
    stroke-width: 1
  }
}

or-label-1: {
  shape: text
  label: "OR"
  style.font-size: 18
  style.bold: true
  style.fill: "#fff"
  style.stroke: "#666"
  style.stroke-width: 2
}
